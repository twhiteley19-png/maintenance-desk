# Copy to .env and fill in what you have. The app runs without any keys
# using deterministic heuristic triage and logged-not-sent messaging
# (fine for demos and the eval harness).

# --- AI triage (optional) ---
ANTHROPIC_API_KEY=<redacted>
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- emergency rules ---
# "No heat" counts as an emergency only when OUTSIDE_TEMP_F is under 40.
OUTSIDE_TEMP_F=35
# Set to false to never treat no-heat as an emergency.
NO_HEAT_EMERGENCY=true

# --- Twilio (Phase 1: real SMS in/out) ---
TWILIO_ACCOUNT_SID=<redacted>
TWILIO_AUTH_TOKEN=<redacted>
TWILIO_PHONE_NUMBER=+19195551234
# Mobile that gets emergency SMS + voice-call alerts (reply ACK to ack).
MANAGER_PHONE=+19195559999
# Public base URL of this server (used for webhook + voice URLs).
PUBLIC_BASE_URL=https://desk.example.com

# --- business hours (after-hours hold) ---
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00

# --- emergency alert repeat (minutes between SMS+call until ACK) ---
EMERGENCY_ALERT_REPEAT_MINUTES=10

# --- vendor ack timeouts (minutes) ---
VENDOR_TIMEOUT_ROUTINE_MIN=30
VENDOR_TIMEOUT_URGENT_MIN=10

# --- next-day fix check ---
FIX_CHECK_HOUR=10
FIX_CHECK_REPLY_WINDOW_HOURS=24

# --- single-manager auth (UI login) ---
# Empty = no login (local dev only). Set a password before going live.
MANAGER_PASSWORD=<redacted>
SESSION_SECRET=<redacted>
# Set false to run the web UI without the background scheduler thread.
SCHEDULER_ENABLED=true

# --- AppFolio read-only import ---
APPFOLIO_CLIENT_ID=<redacted>
APPFOLIO_CLIENT_SECRET=<redacted>
APPFOLIO_API_BASE=https://api.appfolio.com

# Optional: point at a different database.
# DATABASE_URL=<redacted>
